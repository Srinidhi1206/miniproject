# =====================================================================
# SENTINEL environment configuration
# Copy to `.env` (backend reads it from the repo root or backend/).
# Everything here is OPTIONAL locally — SENTINEL runs fully offline with defaults.
# Never commit a real `.env`. Production values are set in the hosting dashboards
# (Render for the backend — see render.yaml — and Vercel for the frontend).
# =====================================================================

# ---------- Core ----------
# Reported by /api/health. Production (Render): production
SENTINEL_ENV=development

# Database. Default (if unset): SQLite file at backend/var/sentinel.db
# For PostgreSQL (docker-compose provides one):
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# postgres:// and postgresql:// URLs (Render, Neon, Heroku) are also accepted.
# Production (Render): injected automatically from the sentinel-db database.
DATABASE_URL=

# Comma-separated list of exact browser origins allowed to call the API.
# Production: https://miniproject-sage-rho.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for additional origins (e.g. Vercel preview deployments).
CORS_ORIGIN_REGEX=

# ---------- Uploads ----------
MAX_UPLOAD_MB=8

# ---------- Rate limiting (per client IP, analyze + report endpoints) ----------
RATE_LIMIT_PER_MINUTE=30

# ---------- LLM explanation layer (optional) ----------
# none      -> grounded template explanations built from evidence + RAG (default, offline)
# anthropic -> Claude rewrites the grounded explanation in plain language
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# ---------- RAG ----------
# Only "local" is implemented: LSA (TF-IDF + SVD) embeddings fitted on the
# knowledge base, FAISS index (offline). Kept as a switch for future embedders.
RAG_EMBEDDINGS=local

# ---------- URL reputation (optional) ----------
# Google Safe Browsing v4 API key. When unset, reputation lookups are skipped
# and the result says so — they are never faked.
URL_REPUTATION_API_KEY=

# ---------- Demo data ----------
# 1 = seed clearly flagged, fictional reports so the scam map isn't empty (default).
# 0 = start with an empty map (only real submissions).
SEED_DEMO=1

# ---------- Frontend ----------
# Where the browser reaches the backend API. Inlined at BUILD time and public.
# Production (Vercel env var): https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the Next.js SERVER reaches the API (server-rendered Safety Center).
# Defaults to NEXT_PUBLIC_API_URL; in docker-compose it is http://backend:8000.
INTERNAL_API_URL=
